{
  "$schema": "https://schema.tauri.app/config/2.0",
  "productName": "One-Time Secret",
  "version": "0.1.0",
  "identifier": "dev.onetimesecret.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "One-Time Secret",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://onetimesecret.dev; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "One-Time Secret",
    "copyright": "Copyright (c) 2024 One-Time Secret",
    "category": "Utility",
    "shortDescription": "Secure desktop client for One-Time Secret",
    "longDescription": "A secure, privacy-focused desktop application for creating and managing one-time secrets using the One-Time Secret service."
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
